<a:Comment>Data, hora, minuto e segundo de quando a execução da etapa do objeto JobExecution foi iniciada.</a:Comment>
<a:DataType>datetime2(7)</a:DataType>
<a:Length>7</a:Length>
<a:Column.Mandatory>1</a:Column.Mandatory>
<a:GlobalObjectID/>
