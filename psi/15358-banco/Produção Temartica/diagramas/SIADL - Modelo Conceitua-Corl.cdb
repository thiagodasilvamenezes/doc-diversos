<c:BusinessRules>
<o:BusinessRule Id="o78">
<a:ObjectID>A1C55C8E-8269-4DF9-91DE-C5AB91CA1460</a:ObjectID>
<a:Name>Especializacao CLIENTE</a:Name>
<a:Code>RN_CLIENTE_ESPECIALIZACAO</a:Code>
<a:CreationDate>1783902770</a:CreationDate>
<a:Creator>thiag</a:Creator>
<a:ModificationDate>1783902770</a:ModificationDate>
<a:Modifier>thiag</a:Modifier>
<a:Comment>Especializacao total e exclusiva: todo CLIENTE e PESSOA_FISICA ou PESSOA_JURIDICA, nunca ambos.</a:Comment>
</o:BusinessRule>
<o:BusinessRule Id="o79">
<a:ObjectID>20065A8C-90EE-4F86-AB37-AE12EF3B3C2D</a:ObjectID>
<a:Name>Vigencia de limite</a:Name>
<a:Code>RN_LIMITE_VIGENCIA</a:Code>
<a:CreationDate>1783902770</a:CreationDate>
<a:Creator>thiag</a:Creator>
<a:ModificationDate>1783902770</a:ModificationDate>
<a:Modifier>thiag</a:Modifier>
<a:Comment>Vigencias nao podem se sobrepor por conta e tipo de limite; no maximo um registro vigente.</a:Comment>
</o:BusinessRule>
<o:BusinessRule Id="o80">
<a:ObjectID>CC260FE5-1FF9-434A-8A5D-012A104E22BC</a:ObjectID>
<a:Name>Historico append-only</a:Name>
<a:Code>RN_TRANSACAO_HISTORICO</a:Code>
<a:CreationDate>1783902770</a:CreationDate>
<a:Creator>thiag</a:Creator>
<a:ModificationDate>1783902770</a:ModificationDate>
<a:Modifier>thiag</a:Modifier>
<a:Comment>TRANSACAO_HISTORICO permite apenas inclusao. Alteracoes geram um novo evento.</a:Comment>
</o:BusinessRule>
<o:BusinessRule Id="o81">
<a:ObjectID>4651387F-6A2E-4EAB-BC53-CE6B519503A7</a:ObjectID>
<a:Name>LEGENDA — CLASSIFICACAO VISUAL</a:Name>
<a:Code>LEG_TITULO</a:Code>
<a:CreationDate>1783902770</a:CreationDate>
<a:Creator>thiag</a:Creator>
<a:ModificationDate>1783902770</a:ModificationDate>
<a:Modifier>thiag</a:Modifier>
<a:Comment>As cores representam classes funcionais e nao alteram a semantica.</a:Comment>
</o:BusinessRule>
<o:BusinessRule Id="o82">
<a:ObjectID>99668FDB-7E8D-4505-BA41-4882BE075CB0</a:ObjectID>
<a:Name>Azul-claro — entidade mestre, cadastral ou operacional</a:Name>
<a:Code>LEG_MESTRE</a:Code>
<a:CreationDate>1783902770</a:CreationDate>
<a:Creator>thiag</a:Creator>
<a:ModificationDate>1783902770</a:ModificationDate>
<a:Modifier>thiag</a:Modifier>
<a:Comment>CLIENTE, PF, PJ, CONTA, LIMITE_CONTA e DISPOSITIVO_CLIENTE.</a:Comment>
</o:BusinessRule>
