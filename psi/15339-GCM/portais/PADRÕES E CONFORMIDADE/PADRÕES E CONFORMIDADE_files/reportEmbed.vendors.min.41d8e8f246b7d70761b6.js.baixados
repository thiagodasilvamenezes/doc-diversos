  ::slotted([slot='start']) {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-right: ${f.z42};
    grid-column: 2 / span 1;
    grid-row: 1;
  }

  button:focus-visible::after {
    content: '';
    position: absolute;
    inset: 0px;
    cursor: pointer;
    border-radius: ${f.aUB};
    outline: none;
    border: 2px solid ${f.D8b};
    box-shadow: inset 0 0 0 1px ${f.Kpd};
  }

